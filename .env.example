# Copy to .env and fill in. .env is gitignored and baked into local builds.
#
# Trakt: create an app at https://developer.trakt.tv/apps with redirect URI
#   https://silvercrocus.github.io/nextep/callback
# Only the Client ID is needed; Trakt issues no secret to apps on a device.
TRAKT_CLIENT_ID=

# TMDB (posters and artwork): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
